{
  "name": "rag-interview-questions-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build_site.mjs",
    "test": "node --test \"scripts/lib/*.test.mjs\"",
    "check": "node scripts/check_questions.mjs check",
    "check:strict": "node scripts/check_questions.mjs check --strict",
    "gaps": "node scripts/check_questions.mjs gaps",
    "readme": "node scripts/check_questions.mjs readme --write",
    "mcq-length": "node scripts/check_questions.mjs mcq-length",
    "readme:check": "node scripts/check_questions.mjs readme --check",
    "ci": "npm run lint && npm test && npm run check && npm run readme:check && npm run build && npm run test:site",
    "test:site": "node scripts/site.smoke.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.3",
    "marked": "^18.0.13",
    "marked-gfm-heading-id": "^4.1.4"
  }
}
